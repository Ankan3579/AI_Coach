# LiveKit Cloud or self-hosted server connection.
LIVEKIT_URL=wss://your-livekit-host
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
FRONTEND_ORIGINS=http://localhost:3000

# Sarvam speech recognition and speech generation.
SARVAM_API_KEY=
SARVAM_LANGUAGE=en-IN
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=kavya

# Chat completion providers. Leave unused provider keys blank.
# OPENAI_API_KEY is also used by the existing Whisper audio-transcription route.
OPENAI_API_KEY=
OPENAI_MODEL=openai/gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=groq/llama-3.3-70b-versatile
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral/mistral-small-latest

# Fallback order is comma-separated; providers without keys are skipped.
LLM_FALLBACK_ENABLED=true
LLM_FALLBACK_ORDER=openai,groq,mistral,local
# Safety screening tries Groq first, then the configured providers as fallback.

# Local Ollama is available as the final fallback by default.
LOCAL_LLM_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_OPENAI_BASE_URL=http://localhost:11434/v1
